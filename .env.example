# Copy to .env for local work (cp .env.example .env  /  Copy-Item .env.example .env).
# .env is gitignored. Never commit it, never send it over Teams or email.
# Lines ending in "# kv:<name>" are secrets: get_secret("<name>") reads them from here,
# or from Azure Key Vault once KEY_VAULT_URL is set.

APP_ENV=local
LOG_LEVEL=INFO

# Optional: set to read secrets from Azure Key Vault instead of this file
# (also run: uv sync --all-packages --extra keyvault). Leave empty to start.
KEY_VAULT_URL=

# --- Secrets: one line per secret, named after it. Fake values only on laptops. ---
EXAMPLE_API_KEY=  # kv:example-api-key
